---
import type { CollectionEntry } from "astro:content";
import StatusTag from "./StatusTag.astro";
import ProjectMedia from "./ProjectMedia.astro";

interface Props {
  project: CollectionEntry<"projets">;
}

const { project } = Astro.props;
const { title, eyebrow, summary, status, statusLabel, products } = project.data;
const href = `/projets/${project.id}/`;
---

<article class="card project">
  <ProjectMedia project={project} class="media" widths={[480, 720, 960]} sizes="(min-width: 1000px) 380px, 100vw" />
  <div class="body">
    <div class="top">
      <span class="eyebrow">{eyebrow}</span>
      <StatusTag status={status} label={statusLabel} />
    </div>
    <h3 class="display"><a href={href}>{title}</a></h3>
    <p>{summary}</p>
    {products && (
      <div class="pills">
        {products.map((p) => <span class="pill">{p.name}</span>)}
      </div>
    )}
  </div>
</article>

<style>
  .project { position: relative; padding: 12px 12px 20px; gap: 16px; transition: border-color 0.15s, transform 0.15s; }
  .project:hover { border-color: var(--muted); }
  .project:hover h3 a { color: var(--accent); }
  .project :global(.media) { min-height: 0; aspect-ratio: 16 / 10; }
  .body { display: flex; flex-direction: column; gap: 8px; padding: 0 8px; }
  .top { display: flex; justify-content: space-between; align-items: center; gap: 8px 12px; flex-wrap: wrap; }
  h3 { margin: 0; font-size: 21px; }
  h3 a { color: var(--fg); text-decoration: none; }
  /* toute la carte est cliquable */
  h3 a::after { content: ""; position: absolute; inset: 0; border-radius: var(--radius); }
  p { margin: 0; color: var(--text); font-size: 15px; line-height: 1.55; }
  .pills { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }
</style>
