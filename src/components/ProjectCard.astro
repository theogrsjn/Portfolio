---
import type { CollectionEntry } from "astro:content";
import StatusTag from "./StatusTag.astro";

interface Props {
  project: CollectionEntry<"projets">;
  wide?: boolean;
}

const { project, wide = false } = Astro.props;
const { title, eyebrow, summary, status, statusLabel, products, cover } = project.data;
const href = `/projets/${project.id}/`;
---

<article class:list={["card", "project", { wide }]}>
  <div class="ph media">{cover}</div>
  <div class="body">
    <div class="top">
      <span class="eyebrow">{eyebrow}</span>
      <StatusTag status={status} label={statusLabel} />
    </div>
    <h3 class="display"><a href={href}>{title}</a></h3>
    <p>{summary}</p>
    {products && (
      <div class="pills">
        {products.map((p) => <span class="pill">{p.name}</span>)}
      </div>
    )}
    {wide && <span class="more">Lire l'étude de cas →</span>}
  </div>
</article>

<style>
  .project { position: relative; }
  .project:hover h3 a { color: var(--accent); }
  .media { min-height: 240px; }
  .body { display: flex; flex-direction: column; gap: 14px; }
  .top { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  h3 { margin: 0; font-size: clamp(30px, 3.4vw, 36px); font-stretch: 112%; }
  h3 a { color: var(--fg); text-decoration: none; }
  /* toute la carte est cliquable */
  h3 a::after { content: ""; position: absolute; inset: 0; border-radius: var(--radius); }
  p { margin: 0; color: var(--text); }
  .pills { display: flex; flex-wrap: wrap; gap: 8px; }
  .more { font-weight: 600; color: var(--accent); }

  .wide {
    padding: 0;
    overflow: hidden;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0;
  }
  .wide .media { flex: 1 1 560px; min-height: 380px; border-radius: 0; }
  .wide .body { flex: 1 1 360px; min-width: 0; padding: clamp(24px, 3vw, 40px); justify-content: center; }
  .wide h3 { font-size: clamp(34px, 4vw, 44px); }
</style>
