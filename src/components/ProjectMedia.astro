---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import CoreXtensionVisual from "./CoreXtensionVisual.astro";

interface Props {
  project: CollectionEntry<"projets">;
  // largeurs générées selon l'emplacement (carte ou page projet)
  widths: number[];
  sizes: string;
  class?: string;
  eager?: boolean;
  // grand format (en-tête de page projet)
  tall?: boolean;
}

const { project, widths, sizes, class: className, eager = false, tall = false } = Astro.props;
const { image, imageAlt, imageFit, imagePosition, visual, cover, products } = project.data;
// en grand format, une photo verticale est affichée entière plutôt que rognée et agrandie
const fit = tall && image && image.height > image.width ? "portrait" : imageFit;
---

{image ? (
  <div class:list={["media", `fit-${fit}`, { tall }, className]}>
    {fit === "portrait" && <Image src={image} alt="" widths={[320]} sizes="320px" format="webp" class="backdrop" aria-hidden="true" />}
    <Image
      src={image}
      alt={imageAlt ?? ""}
      widths={widths}
      sizes={sizes}
      format="webp"
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : undefined}
      style={`object-position: ${imagePosition}`}
    />
  </div>
) : visual === "corextension" ? (
  <div class:list={["media", "fit-visual", { tall }, className]}>
    <CoreXtensionVisual products={(products ?? []).map((p) => p.name)} />
  </div>
) : (
  <div class:list={["ph", { tall }, className]}>{cover}</div>
)}

<style>
  .media {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-sm);
    min-height: 200px;
  }
  .media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .fit-cover :global(img) { object-fit: cover; }
  .fit-contain { background: var(--render-bg); }
  .fit-contain :global(img) { object-fit: contain; padding: 24px; }
  .fit-portrait { background: var(--card); }
  .fit-portrait :global(img) { object-fit: contain; }
  .fit-portrait :global(img.backdrop) { object-fit: cover; filter: blur(28px) saturate(1.1); transform: scale(1.15); opacity: 0.7; }
  .fit-visual { display: flex; }
  .tall { min-height: clamp(280px, 48vw, 620px); border-radius: var(--radius); }
</style>
