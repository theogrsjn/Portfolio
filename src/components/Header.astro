---
import { nav, site } from "../data/site";

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="brand" aria-label="Théo Grosjean, accueil">
      <span class="mark" aria-hidden="true">TG</span>
      <span class="who">
        <span class="name">{site.name}</span>
        <span class="role">Systèmes embarqués</span>
      </span>
    </a>

    <nav id="menu" class="nav" aria-label="Navigation principale">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="tools">
      <button class="icon-btn" type="button" aria-label="Changer de thème" data-theme-toggle>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor"></path>
        </svg>
      </button>
      <a class="btn btn--solid btn--sm cta" href="/contact/">Me contacter</a>
      <button class="icon-btn burger" type="button" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="menu" data-menu-toggle>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const themeBtn = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  themeBtn?.addEventListener("click", () => {
    const root = document.documentElement;
    const current =
      root.dataset.theme ?? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    const next = current === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {}
  });

  const menuBtn = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const header = document.querySelector(".site-header");
  menuBtn?.addEventListener("click", () => {
    const open = header?.classList.toggle("open") ?? false;
    menuBtn.setAttribute("aria-expanded", String(open));
    menuBtn.setAttribute("aria-label", open ? "Fermer le menu" : "Ouvrir le menu");
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--header-bg);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--line-soft);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 68px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--fg);
    margin-right: auto;
  }
  .mark {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 9px;
    background: var(--fg);
    color: var(--bg);
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 110%;
    font-size: 14px;
    letter-spacing: -0.02em;
  }
  .who { display: flex; flex-direction: column; line-height: 1.2; }
  .name { font-weight: 600; font-size: 15px; }
  .role { font-size: 12px; color: var(--muted); }

  .nav ul { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  .nav a {
    display: block;
    padding: 8px 12px;
    border-radius: 8px;
    color: var(--text);
    text-decoration: none;
    font-size: 15px;
    font-weight: 500;
  }
  .nav a:hover { color: var(--fg); background: var(--card); }
  .nav a[aria-current="page"] { color: var(--fg); background: var(--card); box-shadow: inset 0 0 0 1px var(--line-soft); }

  .tools { display: flex; align-items: center; gap: 8px; }
  .icon-btn {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    border: 1px solid var(--line-soft);
    background: var(--card);
    color: var(--fg);
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .icon-btn:hover { border-color: var(--fg); }
  .burger { display: none; }

  @media (max-width: 900px) {
    .bar { flex-wrap: wrap; gap: 12px; min-height: 60px; }
    .burger { display: grid; }
    .cta { display: none; }
    .nav { display: none; order: 3; flex-basis: 100%; padding-bottom: 12px; }
    .site-header.open .nav { display: block; }
    .nav ul { flex-direction: column; gap: 2px; }
    .nav a { padding: 10px 12px; }
  }
</style>
