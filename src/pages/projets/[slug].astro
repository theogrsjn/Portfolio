---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import StatusTag from "../../components/StatusTag.astro";
import ProjectMedia from "../../components/ProjectMedia.astro";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const projects = await getCollection("projets");
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
  project: CollectionEntry<"projets">;
}

const { project } = Astro.props;
const d = project.data;
const { Content } = await render(project);
---

<Base title={d.title} description={d.summary}>
  <a class="back mono" href="/projets/">← Tous les projets</a>

  <header class="head">
    <div class="top">
      <span class="eyebrow">{d.eyebrow}</span>
      <StatusTag status={d.status} label={d.statusLabel} />
    </div>
    <h1 class="display">{d.title}</h1>
    <p class="lead">{d.summary}</p>
  </header>

  <ProjectMedia project={project} tall widths={[640, 960, 1280, 1920]} sizes="(min-width: 1320px) 1240px, 100vw" eager />

  <div class="layout">
    <aside class="card meta">
      <dl>
        <div><dt class="mono muted">Rôle</dt><dd>{d.role}</dd></div>
        {d.period && <div><dt class="mono muted">Période</dt><dd>{d.period}</dd></div>}
        {d.context && <div><dt class="mono muted">Cadre</dt><dd>{d.context}</dd></div>}
        <div>
          <dt class="mono muted">Technologies</dt>
          <dd class="pills">{d.stack.map((s) => <span class="pill">{s}</span>)}</dd>
        </div>
        {d.links && (
          <div>
            <dt class="mono muted">Liens</dt>
            <dd class="links">
              {d.links.map((l) => <a href={l.url} rel="noopener" target="_blank">{l.label} ↗</a>)}
            </dd>
          </div>
        )}
      </dl>
    </aside>

    <div class="main">
      {d.facts && (
        <div class="row facts">
          {d.facts.map((f) => (
            <div class="card">
              <div class="display fact">{f.value}</div>
              <div class="mono muted small">{f.label}</div>
            </div>
          ))}
        </div>
      )}

      {d.products && (
        <div class="row products">
          {d.products.map((p) => (
            <div class="card product">
              <div class="display pname">{p.name}</div>
              <p>{p.desc}</p>
              {p.url && <a href={p.url} rel="noopener" target="_blank">{new URL(p.url).host} ↗</a>}
            </div>
          ))}
        </div>
      )}

      <article class="prose">
        <Content />
      </article>

      {d.gallery && (
        <section class="gallery" aria-label="Photos du projet">
          <h2 class="display">En images</h2>
          <div class="shots">
            {d.gallery.map((g) => (
              <figure>
                <Image src={g.src} alt={g.alt} widths={[480, 720, 960]} sizes="(min-width: 1000px) 30vw, 100vw" format="webp" loading="lazy" />
                <figcaption class="muted">{g.alt}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      )}
    </div>
  </div>
</Base>

<style>
  .back { display: inline-block; margin-top: 28px; font-size: 13px; color: var(--muted); text-decoration: none; }
  .back:hover { color: var(--fg); }
  .head { display: flex; flex-direction: column; gap: 14px; padding: 20px 0 32px; }
  .top { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
  h1 { margin: 0; font-size: var(--fs-h1); }

  .layout { display: flex; flex-wrap: wrap; gap: 32px; margin-top: 32px; align-items: flex-start; }
  .meta { flex: 1 1 260px; max-width: 100%; position: sticky; top: 92px; }
  @media (max-width: 900px) { .meta { position: static; } }
  .main { flex: 999 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
  dl { margin: 0; display: flex; flex-direction: column; gap: 20px; }
  dt { font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 6px; }
  dd { margin: 0; }
  .pills { display: flex; flex-wrap: wrap; gap: 6px; }
  .pills .pill { font-size: 13px; padding: 3px 10px; }
  .links { display: flex; flex-direction: column; gap: 4px; }

  .facts { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 170px), 1fr)); }
  .fact { font-size: 28px; line-height: 1.1; }
  .small { font-size: 13px; }
  .products { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); }
  .pname { font-size: 17px; }
  .product p { margin: 0; color: var(--text); font-size: 15px; }

  .gallery { margin-top: 32px; display: flex; flex-direction: column; gap: 16px; }
  .gallery h2 { margin: 0; font-size: 22px; }
  .shots { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: 16px; }
  figure { margin: 0; display: flex; flex-direction: column; gap: 8px; }
  figure :global(img) { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; border-radius: var(--radius-sm); }
  figcaption { font-size: 14px; }
  .prose :global(blockquote) {
    margin: 0 0 24px;
    padding: 16px 20px;
    background: var(--warn-bg);
    color: var(--warn-fg);
    border-radius: var(--radius-sm);
  }
  .prose :global(blockquote p) { margin: 0; }
</style>
