---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";

const all = (await getCollection("projets")).sort((a, b) => a.data.order - b.data.order);
const sections = [
  {
    id: "personnels",
    title: "Projets personnels",
    intro: "Des projets lancés de ma propre initiative, de l'idée jusqu'à la mise en service.",
    items: all.filter((p) => p.data.kind === "personnel"),
  },
  {
    id: "etudes",
    title: "Projets d'études",
    intro: "Des projets réalisés pendant mon cursus d'ingénieur, souvent en équipe.",
    items: all.filter((p) => p.data.kind === "etudes"),
  },
];
---

<Base title="Projets" description="Projets de Théo Grosjean : électronique embarquée, robotique, véhicule hydrogène, logiciels full-stack et infrastructure.">
  <section class="page-head">
    <div class="eyebrow">Projets</div>
    <h1 class="display">Ce que je construis</h1>
    <p class="lead">Des cartes électroniques, un rover, un véhicule à hydrogène, des logiciels utilisés par des centaines d'étudiants.</p>
    <nav class="jump" aria-label="Sections">
      {sections.map((s) => <a class="pill" href={`#${s.id}`}>{s.title} <span class="mono muted">{s.items.length}</span></a>)}
    </nav>
  </section>

  {sections.map((s) => (
    <section id={s.id}>
      <div class="section-head">
        <h2 class="display">{s.title}</h2>
        <span class="muted">{s.intro}</span>
      </div>
      <div class="row grid">
        {s.items.map((p) => <ProjectCard project={p} />)}
      </div>
    </section>
  ))}
</Base>

<style>
  .jump { display: flex; flex-wrap: wrap; gap: 8px; }
  .jump .pill { color: var(--fg); text-decoration: none; gap: 8px; }
  .jump .pill:hover { background: var(--fg); color: var(--bg); }
  .jump .pill:hover .muted { color: inherit; }
  section[id] { scroll-margin-top: 24px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); }
  .section-head span { font-size: 15px; }
</style>
