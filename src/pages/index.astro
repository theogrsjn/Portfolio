---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { site, stats } from "../data/site";

const projects = (await getCollection("projets", (p) => p.data.featured)).sort(
  (a, b) => a.data.order - b.data.order,
);
const [lead, ...rest] = projects;
---

<Base>
  <section class="hero">
    <h1 class="display name">Théo<br />Grosjean<span>.</span></h1>
    <div class="hero-foot">
      <p class="lead">Étudiant ingénieur en systèmes embarqués. Je conçois du PCB jusqu'au serveur.</p>
      <div class="actions">
        <a class="btn btn--solid" href={site.cv}>Télécharger le CV</a>
        <a class="btn" href={site.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
      </div>
    </div>
  </section>

  <div class="row stats">
    {stats.map((s) => (
      <div class="card">
        <div class="display stat">{s.value}{s.sup && <sup>{s.sup}</sup>}</div>
        <div class="mono muted label">{s.label}</div>
      </div>
    ))}
    <a class="card card--accent avail" href="/contact/">
      <div class="display avail-title">{site.availability.title}</div>
      <p>{site.availability.detail}</p>
    </a>
  </div>

  <div class="section-head">
    <h2 class="display">Projets</h2>
    <a href="/projets/">Tous les projets →</a>
  </div>

  <div class="projects">
    {lead && <ProjectCard project={lead} wide />}
    <div class="row">
      {rest.map((p) => <ProjectCard project={p} />)}
    </div>
  </div>
</Base>

<style>
  .hero { display: flex; flex-direction: column; gap: 32px; padding: clamp(32px, 6vw, 56px) 0 40px; }
  .name {
    margin: 0;
    font-weight: 900;
    font-size: clamp(64px, 11.5vw, 152px);
    line-height: 0.88;
    letter-spacing: -0.045em;
  }
  .name span { color: var(--accent); }
  .hero-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 32px 40px;
    align-items: flex-end;
    justify-content: space-between;
  }
  .hero-foot .lead { flex: 1 1 480px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }

  .stat { font-size: clamp(48px, 6vw, 64px); }
  .stat sup { font-size: 0.45em; }
  .label { font-size: 14px; }
  .avail { text-decoration: none; }
  .avail:hover { color: var(--on-accent); filter: brightness(1.08); }
  .avail-title { font-size: 28px; line-height: 1.1; letter-spacing: -0.02em; }
  .avail p { margin: 0; font-size: 15px; }

  .projects { display: flex; flex-direction: column; gap: 16px; }
  .projects .row > :global(*) { flex-basis: 420px; }
</style>
